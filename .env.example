# VITE_API_URL=https://api.webmonitor.devsoftbr.com
VITE_API_URL=/api
# destino do proxy do Vite para /api (padrão: http://localhost:4444)
# VITE_API_PROXY_TARGET=http://localhost:4444
VITE_DEBOUNCE_DELAY=500
VITE_WHATSAPP_DOCUMENT_TYPES=text/plain,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/pdf
VITE_WHATSAPP_IMAGE_TYPES=image/jpeg,image/png
# VITE_CLARITY=u1gipamm92
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Configuração do Login do Facebook para Empresas com as permissões de anúncios (ads_read, ads_management, business_management, leads_retrieval)
VITE_META_ADS_LOGIN_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v23.0
# Client OAuth "Web" do Google Cloud para conectar o Google Agenda dos agentes de IA (o secret fica no back)
VITE_GOOGLE_OAUTH_CLIENT_ID=
